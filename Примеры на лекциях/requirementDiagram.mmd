requirementDiagram

    %% === ГРУППА ТРЕБОВАНИЙ (Иерархия) ===
    requirement "REQ-1" {
        id: 1
        text: Система должна обрабатывать заказы
        risk: low
    }
    
    requirement "REQ-1.1" {
        id: 1.1
        text: Проверять наличие товара на складе
        risk: medium
    }
    
    requirement "REQ-1.2" {
        id: 1.2
        text: Принимать онлайн-оплату
        risk: high
    }
    
    requirement "REQ-1.3" {
        id: 1.3
        text: Отправлять подтверждение на email
        risk: low
    }

    %% === СВЯЗИ ИЕРАРХИИ ===
    REQ-1 -- contain --> REQ-1.1
    REQ-1 -- contain --> REQ-1.2
    REQ-1 -- contain --> REQ-1.3

    %% === БЛОКИ СИСТЕМЫ (Что реализует требования) ===
    element "processOrder()" {
        type: Function
    }
    
    element "chargeCard()" {
        type: Function
    }
    
    element "confirmEmail()" {
        type: Function
    }

    %% === ТЕСТЫ (Чем проверяем) ===
    element "TC_Inventory_Test" {
        type: TestCase
    }
    
    element "TC_Payment_Test" {
        type: TestCase
    }

    %% === СВЯЗИ РЕАЛИЗАЦИИ И ПРОВЕРКИ ===
    processOrder() -- satisfy --> REQ-1.1
    chargeCard() -- satisfy --> REQ-1.2
    confirmEmail() -- satisfy --> REQ-1.3

    TC_Inventory_Test -- verify --> REQ-1.1
    TC_Payment_Test -- verify --> REQ-1.2

    %% === ВЫВОДНЫЕ ТРЕБОВАНИЯ (Derive) ===
    REQ-1 -- derive --> REQ-1.1
    REQ-1 -- derive --> REQ-1.2
    REQ-1 -- derive --> REQ-1.3
